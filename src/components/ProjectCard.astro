---
interface Props {
  slug: string;
  title: string;
  summary: string;
  stack: string[];
}

const { slug, title, summary, stack } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class="block rounded-lg border border-slate-200 p-5 transition hover:border-slate-400 dark:border-slate-800 dark:hover:border-slate-600"
>
  <h3 class="text-lg font-semibold">{title}</h3>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{summary}</p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {
      stack.map((tech) => (
        <li class="rounded bg-slate-100 px-2 py-0.5 text-xs dark:bg-slate-800">{tech}</li>
      ))
    }
  </ul>
</a>
