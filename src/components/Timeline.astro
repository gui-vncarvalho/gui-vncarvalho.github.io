---
import SectionHead from './SectionHead.astro';
import { AXIS, YEAR_WEIGHT, timeline } from '../data/timeline';

const span = AXIS.to - AXIS.from;
const years = Array.from({ length: span }, (_, i) => AXIS.from + i);
const weight = (y: number) => YEAR_WEIGHT[y] ?? 1;
const total = years.reduce((sum, y) => sum + weight(y), 0);
const pct = (at: number) => {
  const y = Math.floor(at);
  const before = years.filter((year) => year < y).reduce((sum, year) => sum + weight(year), 0);
  return ((before + (at - y) * weight(y)) / total) * 100;
};
const BAR_H = 60;
const STEP = 70;
const AXIS_GAP = 40;
const HEIGHT = 30 + (timeline.length - 1) * STEP + BAR_H + AXIS_GAP;
const barTop = (i: number) => HEIGHT - AXIS_GAP - BAR_H - i * STEP;
const isNarrow = (t: (typeof timeline)[number]) => pct(t.end) - pct(t.start) < 12;
const current = timeline.length - 1;
const onAttrs = (i: number) => ({
  'data-pick': 'tl',
  'data-i': i,
  'data-on': i === current ? '' : undefined,
  'aria-pressed': i === current,
});
---

<section id="trajetoria" class="shell section-gap">
  <SectionHead
    title="Trajetória"
    sub="Da infraestrutura física ao software em nuvem. Role a página para a linha se desenhar e clique em cada etapa."
  />

  <div class="hidden min-[980px]:block">
    <div class="relative mb-[34px]" style={{ height: `${HEIGHT}px` }}>
      <span style={{ top: `${barTop(0) - 46}px` }} class="absolute left-0 rounded-full border border-dashed border-line2 bg-surf px-3.5 py-[7px] text-[13px] font-medium whitespace-nowrap text-acc">
        a virada: de racks para código
      </span>
      {
        timeline.map((t, i) => (
          <>
            <div
              class="absolute border-l border-dashed border-line2"
              style={{ left: `${pct(t.start)}%`, top: `${barTop(i) + BAR_H}px`, height: `${HEIGHT - barTop(i) - BAR_H}px` }}
            />
            <button
              type="button"
              {...onAttrs(i)}
              data-bar
              class:list={[
                'group chip absolute rounded-[20px] bg-surf text-left whitespace-nowrap',
                isNarrow(t) ? 'p-0' : 'overflow-hidden px-4 py-2.5',
              ]}
              style={{ left: `${pct(t.start)}%`, top: `${barTop(i)}px`, height: `${BAR_H}px`, width: `${pct(t.end) - pct(t.start) - 0.5}%` }}
            >
              <span
                class:list={[
                  'block',
                  isNarrow(t) && 'absolute top-1/2 right-full mr-3 -translate-y-1/2 text-right text-fg group-data-on:text-acc',
                ]}
              >
                <span class="block font-mono text-xs font-medium opacity-90">{t.period}</span>
                <span class="mt-1 block overflow-hidden text-[17px] font-bold text-ellipsis">{t.label}</span>
              </span>
            </button>
          </>
        ))
      }
      <span
        class="pulse absolute right-0 size-3 rounded-full bg-yellow shadow-[0_0_14px_var(--color-yellow)]"
        style={{ top: `${barTop(current) + BAR_H / 2 - 6}px` }}
      />
      <div class="absolute inset-x-0 bottom-0 h-px bg-line2"></div>
      {
        years.map((y) => (
          <span class="absolute -bottom-7 font-mono text-[13px] font-medium text-dim" style={{ left: `${pct(y)}%` }}>
            {y}
          </span>
        ))
      }
    </div>

    {
      timeline.map((t, i) => (
        <div
          data-pane="tl"
          data-i={i}
          hidden={i !== current}
          class="mt-11 grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] items-center gap-10 rounded-[32px] border border-line bg-surf px-[clamp(22px,3vw,40px)] py-[clamp(22px,3vw,36px)]"
        >
          <div>
            <div class="flex flex-wrap items-baseline gap-4">
              <span class="font-display text-[clamp(36px,4vw,56px)] leading-none font-extrabold tracking-[-0.03em]">{t.period}</span>
              <span class="font-mono text-[13px] text-acc">commit {t.hash}</span>
            </div>
            <h3 class="mt-4 text-[clamp(21px,2vw,28px)] leading-[1.2] font-bold">{t.title}</h3>
            <p class="mt-3 text-[clamp(16px,1.4vw,19px)] leading-[1.55] text-dim">{t.body}</p>
          </div>
          <div>
            <p class="font-display text-[clamp(48px,5.5vw,80px)] leading-none font-extrabold tracking-[-0.04em] text-acc">{t.stat}</p>
            <p class="mt-1.5 text-lg font-medium">{t.statLabel}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {t.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>

  <ol class="ml-2 border-l-2 border-line2 min-[980px]:hidden">
    {
      timeline
        .map((t, i) => (
          <li class="relative pb-[22px] pl-[22px]">
            <button type="button" {...onAttrs(i)} class="group w-full text-left">
              <span class="absolute top-2 -left-2 size-3.5 rounded-full border-2 border-yellow bg-bg group-data-on:bg-yellow" />
              <span class="block rounded-[20px] border-[1.5px] border-line bg-surf px-[18px] py-4 transition-all duration-200 group-data-on:border-yellow group-data-on:bg-yellow group-data-on:text-ink">
                <span class="block font-mono text-xs font-medium">{t.period}</span>
                <span class="mt-1.5 block text-xl leading-[1.2] font-bold">{t.title}</span>
                <span class="hidden group-data-on:block">
                  <span class="mt-2.5 block text-base leading-normal">{t.body}</span>
                  <span class="mt-3.5 block font-display text-[40px] leading-none font-extrabold tracking-[-0.03em]">{t.stat}</span>
                  <span class="block text-sm font-medium">{t.statLabel}</span>
                </span>
              </span>
            </button>
          </li>
        ))
        .reverse()
    }
  </ol>
</section>
