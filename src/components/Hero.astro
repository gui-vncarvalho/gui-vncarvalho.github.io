---
import CodeScene from './CodeScene.astro';
import { site } from '../data/site';

const [first, last] = site.name.split(' ');
const letters = (word: string, base: number) => [...word].map((ch, i) => ({ ch, delay: base + i * 0.07 }));

const stats = [
  { n: 6, before: '', after: '+ anos construindo software' },
  { before: 'Do código ao deploy', after: '' },
];
---

<section id="inicio" class="shell relative pt-[clamp(110px,14vh,150px)]">
  <div
    class="hero-dots pointer-events-none absolute inset-x-[calc(50%-50vw)] -top-10 bottom-0"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-[4%] -right-[8%] aspect-square w-[min(900px,90vw)] rounded-full bg-[radial-gradient(circle,var(--glow),transparent_65%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative grid grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] items-center gap-[clamp(24px,4vw,56px)]">
    <div data-hero-text>
      <span class="inline-flex items-center gap-2.5 rounded-full bg-pill px-4 py-[9px] font-medium">
        <span class="pulse size-[9px] rounded-full bg-yellow"></span>Aberto a novas oportunidades
      </span>
      <p class="mt-[clamp(18px,3vh,28px)] font-mono text-[13px] font-medium tracking-[.08em] text-acc">{site.eyebrow}</p>
      <h1
        class="mt-2 font-display text-[clamp(64px,9.6vw,138px)] leading-[0.9] font-extrabold tracking-[-0.045em]"
        aria-label={`${site.name}.`}
      >
        {
          [letters(first, 0.1), letters(last, 0.7)].map((word, w) => (
            <span class="block" aria-hidden="true">
              {word.map(({ ch, delay }) => (
                <span data-letter class="letter inline-block" style={{ animationDelay: `${delay}s` }}>
                  {ch}
                </span>
              ))}
              {w === 1 && <span class="text-yellow">.</span>}
            </span>
          ))
        }
      </h1>
      <p class="mt-6 max-w-[640px] font-display text-[clamp(24px,2.6vw,36px)] leading-[1.1] font-extrabold tracking-[-0.03em] text-balance">
        {site.tagline}
      </p>
      <p class="mt-4 max-w-[600px] text-[clamp(17px,1.6vw,21px)] leading-[1.45] text-pretty text-dim">{site.description}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#projetos" class="btn-yellow px-[26px] py-[17px] text-lg no-underline">Ver projetos →</a>
        <a href="#contato" class="btn-line px-6 py-4 text-lg no-underline">Falar comigo</a>
      </div>
      <ul class="mt-[30px] flex flex-wrap gap-2.5">
        {
          stats.map((s) => (
            <li class="rounded-full bg-purple px-4 py-2.5 font-medium text-snow">
              {s.before}
              {s.n !== undefined && <span data-count={s.n}>{s.n}</span>}
              {s.after}
            </li>
          ))
        }
      </ul>
    </div>
    <CodeScene />
  </div>
</section>

<style>
  .hero-dots {
    background-image: radial-gradient(var(--dots) 1.2px, transparent 1.5px);
    background-size: 32px 32px;
    mask-image: linear-gradient(#000 0, #000 60%, transparent 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .letter {
      animation: letter-in 0.7s cubic-bezier(0.33, 1, 0.68, 1) both;
    }
  }

  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translateY(70px) rotateX(-50deg);
    }
  }
</style>
