---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillBadge from '../../components/SkillBadge.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, stack, period, metrics, links } = project.data;
---

<BaseLayout title={title} description={summary}>
  <a href="/projects" class="text-sm text-slate-500 hover:underline dark:text-slate-400">
    &larr; Todos os projetos
  </a>

  <h1 class="mt-4 text-2xl font-bold">{title}</h1>
  <p class="mt-1 text-slate-600 dark:text-slate-400">
    {role} · {period.start}{period.end ? `–${period.end}` : ' – atual'}
  </p>

  <div class="mt-3 flex flex-wrap gap-2">
    {stack.map((tech) => <SkillBadge label={tech} />)}
  </div>

  {
    metrics.length > 0 && (
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {metrics.map((metric) => (
          <div class="rounded-lg border border-slate-200 p-3 text-center dark:border-slate-800">
            <p class="text-lg font-semibold">{metric.value}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">{metric.label}</p>
          </div>
        ))}
      </div>
    )
  }

  <article class="prose prose-slate mt-8 max-w-none dark:prose-invert">
    <Content />
  </article>

  {
    (links.live || links.repo) && (
      <div class="mt-8 flex gap-4 text-sm">
        {links.live && (
          <a href={links.live} class="underline" target="_blank" rel="noopener noreferrer">
            Ver site
          </a>
        )}
        {links.repo && (
          <a href={links.repo} class="underline" target="_blank" rel="noopener noreferrer">
            Repositório
          </a>
        )}
      </div>
    )
  }
</BaseLayout>
