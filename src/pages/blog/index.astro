---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog" description="Artigos e estudos técnicos.">
  <h1 class="text-2xl font-bold">Blog</h1>

  {
    posts.length === 0 ? (
      <p class="mt-6 text-slate-600 dark:text-slate-400">Nenhum post publicado ainda.</p>
    ) : (
      <ul class="mt-6 space-y-4">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="text-lg font-medium hover:underline">
              {post.data.title}
            </a>
            <p class="text-sm text-slate-500 dark:text-slate-400">
              {post.data.pubDate.toLocaleDateString('pt-BR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
